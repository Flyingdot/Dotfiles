# Stage 2: everything else. Large downloads (Xcode, Office, Docker), runs unattended.
# brew bundle --file=~/.macos-install/Brewfile.apps

tap "homebrew/services"
tap "junian/dotnet"

# --- dev CLIs
brew "azure-cli"
brew "create-dmg"
brew "mkcert"
brew "opencode"
brew "stripe-cli"
brew "supabase"
brew "ffmpeg"
brew "gnupg"

# --- editors & terminals
cask "cmux"
cask "visual-studio-code"
cask "zed"
cask "t3-code"

# --- AI
cask "claude"
cask "chatgpt"

# --- dev apps
cask "bruno"
cask "docker-desktop"
cask "meld"
cask "microsoft-azure-storage-explorer"
cask "junian/dotnet/dotnet-sdk@10.0"

# --- system & utilities
cask "cleanshot"
cask "scroll-reverser"
cask "tailscale-app"

# --- browsers
cask "firefox"
cask "google-chrome"
cask "microsoft-edge"
cask "zen"

# --- productivity & communication
cask "deepl"
cask "microsoft-office"
cask "microsoft-teams"
cask "obsidian"
cask "signal"
cask "whatsapp"
cask "zoom"

# --- media
cask "sonos"
cask "spotify"
cask "vlc"

# --- Mac App Store
mas "1Password for Safari", id: 1569813296
mas "Adobe Lightroom", id: 1451544217
mas "DaisyDisk", id: 411643860
mas "Microsoft Remote Desktop", id: 1295203466
mas "The Unarchiver", id: 425424353
mas "Toggl Track", id: 1291898086
mas "Ulysses", id: 1225570693
mas "Xcode", id: 497799835

# --- global npm packages
npm "@angular/cli"

# --- VS Code extensions
vscode "angular.ng-template"
vscode "anthropic.claude-code"
vscode "bradlc.vscode-tailwindcss"
vscode "catppuccin.catppuccin-vsc"
